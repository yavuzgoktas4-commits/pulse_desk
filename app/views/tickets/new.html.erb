<% content_for :title, "PulseDesk — Yeni Destek Bileti" %>

<div class="mx-auto max-w-2xl space-y-6">
  <!-- Üst Navigasyon -->
  <div>
    <%= link_to tickets_path, class: "inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 shadow-2xs transition hover:border-slate-300 hover:bg-slate-50" do %>
      <span aria-hidden="true">&larr;</span>
      <span>Bilet Listesine Dön</span>
    <% end %>
  </div>

  <!-- Ortalanmış Modern Form Kartı -->
  <div class="overflow-hidden rounded-2xl border border-slate-200/90 bg-white shadow-sm">
    <!-- Kart Başlığı -->
    <div class="border-b border-slate-200/80 bg-slate-50/60 px-6 py-6 sm:px-8">
      <div class="flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-600 text-white shadow-xs">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
          </svg>
        </span>
        <div>
          <h1 class="text-xl font-bold tracking-tight text-slate-900">Yeni Destek Bileti Oluştur</h1>
          <p class="mt-0.5 text-xs text-slate-500">
            Bilet içeriği kaydedilirken yapay kurallarla analiz edilerek öncelik ve SLA süresi otomatik atanır.
          </p>
        </div>
      </div>
    </div>

    <div class="p-6 sm:p-8 space-y-6">
      <!-- Otomatik SLA Bilgilendirme Bandı -->
      <div class="rounded-xl border border-indigo-200/80 bg-indigo-50/60 p-4 text-xs leading-relaxed text-indigo-950">
        <div class="flex items-start gap-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-indigo-600 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" />
          </svg>
          <div>
            <span class="font-semibold">Akıllı Triyaj & SLA Kuralı:</span>
            Başlık veya açıklamada <code class="rounded bg-indigo-100 px-1.5 py-0.5 font-semibold text-indigo-900">çöktü, acil, ödeme, hata, down, critical</code>
            kelimelerinden biri geçiyorsa bilet <strong>Acil (Urgent — 1 Saat SLA)</strong>, aksi durumda <strong>Normal (4 Saat SLA)</strong> olarak oluşturulur.
          </div>
        </div>
      </div>

      <%= form_with model: @ticket, class: "space-y-5" do |f| %>
        <% if @ticket.errors.any? %>
          <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">
            <p class="font-semibold"><%= @ticket.errors.count %> hata nedeniyle bilet kaydedilemedi:</p>
            <ul class="mt-2 list-disc pl-5 space-y-1 text-xs">
              <% @ticket.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :title, "Bilet Konu Başlığı", class: "block text-sm font-semibold text-slate-800" %>
          <p class="mt-0.5 text-xs text-slate-400">Sorunu özetleyen net bir başlık girin.</p>
          <%= f.text_field :title,
                required: true,
                placeholder: "Örn: ACİL — Kurumsal ödeme sayfasında 502 Bad Gateway hatası alıyoruz",
                class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 shadow-2xs transition focus:border-indigo-600 focus:outline-none focus:ring-4 focus:ring-indigo-500/15" %>
        </div>

        <div>
          <%= f.label :customer_email, "Müşteri Kurumsal E-posta Adresi", class: "block text-sm font-semibold text-slate-800" %>
          <p class="mt-0.5 text-xs text-slate-400">Bildirimlerin ve SLA takibinin ilişkilendirileceği e-posta adresi.</p>
          <%= f.email_field :customer_email,
                required: true,
                placeholder: "ornek: cto@kurumsalsirket.com.tr",
                class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 shadow-2xs transition focus:border-indigo-600 focus:outline-none focus:ring-4 focus:ring-indigo-500/15" %>
        </div>

        <div>
          <%= f.label :description, "Detaylı Sorun Açıklaması", class: "block text-sm font-semibold text-slate-800" %>
          <p class="mt-0.5 text-xs text-slate-400">Hata kodlarını, etkilenen kullanıcı sayısını ve tekrar adımlarını paylaşın.</p>
          <%= f.text_area :description,
                rows: 5,
                required: true,
                placeholder: "Örn: Canlı ortamda SSO entegrasyonu çöktü, kullanıcılarımız sisteme giriş yaparken hata ekranı ilelaşıyor...",
                class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 shadow-2xs transition focus:border-indigo-600 focus:outline-none focus:ring-4 focus:ring-indigo-500/15" %>
        </div>

        <div class="flex items-center justify-end gap-3 border-t border-slate-100 pt-5">
          <%= link_to "Vazgeç", tickets_path, class: "rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition" %>
          <%= f.submit "+ Bileti Oluştur ve SLA Başlat", class: "cursor-pointer rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm ring-1 ring-indigo-600 transition hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-500/20" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
