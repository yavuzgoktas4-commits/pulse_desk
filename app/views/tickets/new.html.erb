<% content_for :title, "PulseDesk — Yeni Bilet Oluştur" %>

<div class="mx-auto max-w-2xl space-y-6">
  <div>
    <%= link_to "← Bilet Listesine Dön", tickets_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-600 hover:text-indigo-600 transition" %>
    <h1 class="mt-3 text-2xl font-bold tracking-tight text-slate-900">Yeni Destek Bileti Oluştur</h1>
    <p class="mt-1 text-sm text-slate-600">
      PulseDesk, bilet içeriğini analiz ederek aciliyet seviyesini ve SLA hedef süresini otomatik olarak belirler.
    </p>
  </div>

  <!-- Akıllı SLA Bilgilendirme Kutusu -->
  <div class="rounded-xl border border-indigo-200 bg-indigo-50/70 p-4 text-xs leading-relaxed text-indigo-900">
    <p class="font-semibold text-indigo-950">Otomatik Öncelik & SLA Kuralı:</p>
    <p class="mt-1">
      Başlık veya açıklama içerisinde <code class="rounded bg-indigo-100 px-1.5 py-0.5 font-semibold text-indigo-900">çöktü, acil, ödeme, hata, down, critical</code>
      kelimelerinden biri geçerse bilet otomatik olarak <strong>Acil (Urgent — 1 Saat SLA)</strong>, aksi halde <strong>Normal (4 Saat SLA)</strong> olarak açılır.
    </p>
  </div>

  <!-- Bilet Formu -->
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">
    <%= form_with model: @ticket, class: "space-y-5" do |f| %>
      <% if @ticket.errors.any? %>
        <div class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800">
          <p class="font-semibold"><%= @ticket.errors.count %> hata nedeniyle bilet kaydedilemedi:</p>
          <ul class="mt-2 list-disc pl-5 space-y-1 text-xs">
            <% @ticket.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :title, "Konu Başlığı", class: "block text-sm font-semibold text-slate-800" %>
        <%= f.text_field :title,
              required: true,
              placeholder: "Örn: Ödeme sayfasında 500 hata kodu alıyorum",
              class: "mt-1.5 block w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20" %>
      </div>

      <div>
        <%= f.label :customer_email, "Müşteri E-posta Adresi", class: "block text-sm font-semibold text-slate-800" %>
        <%= f.email_field :customer_email,
              required: true,
              placeholder: "musteri@sirket.com",
              class: "mt-1.5 block w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20" %>
      </div>

      <div>
        <%= f.label :description, "Sorun Açıklaması", class: "block text-sm font-semibold text-slate-800" %>
        <%= f.text_area :description,
              rows: 5,
              required: true,
              placeholder: "Yaşanan sorunu detaylı şekilde açıklayın...",
              class: "mt-1.5 block w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600/20" %>
      </div>

      <div class="flex items-center justify-end gap-3 pt-2">
        <%= link_to "İptal", tickets_path, class: "rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition" %>
        <%= f.submit "Bileti Oluştur", class: "cursor-pointer rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition" %>
      </div>
    <% end %>
  </div>
</div>
