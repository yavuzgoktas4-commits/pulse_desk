<% content_for :title, "AbisiDesk — Bilet ##{@ticket.id}: #{@ticket.title}" %>
<% breached = @ticket.sla_breached? %>

<div class="mx-auto max-w-4xl space-y-6">
  <!-- Üst Geri Dönüş Barı -->
  <div class="flex items-center justify-between">
    <%= link_to tickets_path, class: "inline-flex items-center gap-2 rounded-xl border border-zinc-800 bg-zinc-900/80 px-3.5 py-2 text-xs font-semibold text-zinc-300 transition hover:border-zinc-700 hover:bg-zinc-800 hover:text-zinc-100" do %>
      <span aria-hidden="true">&larr;</span>
      <span>Bilet Listesine Dön</span>
    <% end %>

    <span class="rounded-lg border border-zinc-800 bg-zinc-900 px-3 py-1 font-mono text-xs font-semibold text-zinc-400">
      Bilet #<%= @ticket.id %>
    </span>
  </div>

  <!-- SLA İhlali Neon Kırmızı Uyarı Bandı -->
  <% if breached %>
    <div class="flex flex-col gap-3 rounded-2xl border border-red-800/60 bg-red-950/60 p-5 text-red-300 backdrop-blur sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-start gap-3.5">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-red-700/60 bg-red-900/60 text-red-300">
          <span class="h-3 w-3 rounded-full bg-red-500 animate-ping"></span>
        </span>
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center rounded-full border border-red-700 bg-red-950 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-red-400">
              SLA İHLALİ / BREACHED
            </span>
            <span class="text-sm font-bold text-red-200">Bu biletin hedef çözüm süresi aşıldı!</span>
          </div>
          <p class="mt-1 text-xs text-red-300/90">
            SLA Hedef Zamanı: <strong><%= @ticket.sla_deadline&.strftime("%d.%m.%Y %H:%M") %></strong> &middot; <%= remaining_sla_text(@ticket) %>
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Koyu Cam (Glassmorphism) Bilet Detay Kartı -->
  <div class="overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/80 backdrop-blur">
    <!-- Kart Başlığı -->
    <div class="border-b border-zinc-800 bg-zinc-950/50 p-6 sm:p-8">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
        <div class="space-y-3">
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(@ticket.status) %>">
              <span class="h-1.5 w-1.5 rounded-full <%= status_dot_classes(@ticket.status) %>"></span>
              <%= status_label(@ticket.status) %>
            </span>

            <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs <%= priority_badge_classes(@ticket.priority) %>">
              <span class="h-1.5 w-1.5 rounded-full <%= priority_dot_classes(@ticket.priority) %>"></span>
              Öncelik: <%= priority_label(@ticket.priority) %>
            </span>

            <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs <%= sla_badge_classes(@ticket) %>">
              <%= remaining_sla_text(@ticket) %>
            </span>
          </div>

          <h1 class="text-xl font-bold tracking-tight text-zinc-100 sm:text-2xl">
            <%= @ticket.title %>
          </h1>

          <div class="flex flex-wrap items-center gap-3 text-xs text-zinc-400">
            <span class="inline-flex items-center gap-2 font-medium text-zinc-200">
              <span class="flex h-6 w-6 items-center justify-center rounded-full border border-cyan-800/60 bg-cyan-950/70 text-[10px] font-bold uppercase text-cyan-300">
                <%= @ticket.customer_email.to_s[0..1] %>
              </span>
              <%= @ticket.customer_email %>
            </span>
            <span class="text-zinc-600">&bull;</span>
            <span>Oluşturulma: <%= @ticket.created_at.strftime("%d.%m.%Y %H:%M") %></span>
          </div>
        </div>

        <!-- Durum Geçiş Aksiyon Butonları -->
        <div class="flex flex-wrap items-center gap-2.5 shrink-0">
          <% if @ticket.status != "open" %>
            <%= button_to "İncelemeye Al (Open)",
                  mark_as_open_ticket_path(@ticket),
                  method: :patch,
                  class: "inline-flex cursor-pointer items-center justify-center rounded-xl border border-amber-700/60 bg-amber-600 px-4 py-2.5 text-xs font-semibold text-white shadow-sm transition hover:bg-amber-500 focus:outline-none focus:ring-4 focus:ring-amber-500/20" %>
          <% end %>

          <% if @ticket.status != "solved" %>
            <%= button_to "Çözüldü Olarak İşaretle (Solved)",
                  mark_as_solved_ticket_path(@ticket),
                  method: :patch,
                  class: "inline-flex cursor-pointer items-center justify-center rounded-xl border border-emerald-700/60 bg-emerald-600 px-4 py-2.5 text-xs font-semibold text-white shadow-sm transition hover:bg-emerald-500 focus:outline-none focus:ring-4 focus:ring-emerald-500/20" %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Kart Gövdesi -->
    <div class="grid grid-cols-1 divide-y divide-zinc-800 lg:grid-cols-3 lg:divide-x lg:divide-y-0">
      <div class="p-6 sm:p-8 lg:col-span-2 space-y-5">
        <% if @ticket.summary.present? || @ticket.category.present? || @ticket.telegram_chat_id.present? %>
          <div class="rounded-2xl border border-cyan-800/50 bg-cyan-950/30 p-4 space-y-2">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-cyan-400">🤖 Groq LLM Anlamsal Analiz Özeti</span>
              <div class="flex items-center gap-2">
                <% if @ticket.category.present? %>
                  <span class="rounded-lg border border-cyan-700/60 bg-cyan-950 px-2.5 py-0.5 text-xs font-semibold text-cyan-300">
                    Kategori: <%= @ticket.category %>
                  </span>
                <% end %>
                <% if @ticket.telegram_chat_id.present? %>
                  <span class="rounded-lg border border-sky-700/60 bg-sky-950 px-2.5 py-0.5 font-mono text-xs text-sky-300">
                    Telegram Chat ID: <%= @ticket.telegram_chat_id %>
                  </span>
                <% end %>
              </div>
            </div>
            <% if @ticket.summary.present? %>
              <p class="text-sm font-medium text-zinc-100"><%= @ticket.summary %></p>
            <% end %>
          </div>
        <% end %>

        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Müşteri Bildirimi & Teknik Açıklama</h2>
          <div class="mt-3 whitespace-pre-line rounded-2xl border border-zinc-800 bg-zinc-950/80 p-5 text-sm leading-relaxed text-zinc-200">
            <%= @ticket.description %>
          </div>
        </div>
      </div>

      <div class="bg-zinc-950/30 p-6 sm:p-8 space-y-4">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-400">SLA & Süreç Metrikleri</h2>

        <dl class="space-y-3 text-sm">
          <div class="rounded-xl border border-zinc-800 bg-zinc-950/70 p-3.5">
            <dt class="text-xs text-zinc-400">SLA Durumu</dt>
            <dd class="mt-1.5">
              <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs <%= sla_badge_classes(@ticket) %>">
                <%= remaining_sla_text(@ticket) %>
              </span>
            </dd>
          </div>

          <div class="rounded-xl border border-zinc-800 bg-zinc-950/70 p-3.5">
            <dt class="text-xs text-zinc-400">SLA Bitiş Hedefi</dt>
            <dd class="mt-1 font-semibold text-zinc-100">
              <%= @ticket.sla_deadline ? @ticket.sla_deadline.strftime("%d.%m.%Y %H:%M") : "-" %>
            </dd>
          </div>

          <div class="rounded-xl border border-zinc-800 bg-zinc-950/70 p-3.5">
            <dt class="text-xs text-zinc-400">Çözülme Zamanı</dt>
            <dd class="mt-1 font-semibold <%= @ticket.resolved_at ? 'text-emerald-400' : 'text-zinc-500' %>">
              <%= @ticket.resolved_at ? @ticket.resolved_at.strftime("%d.%m.%Y %H:%M") : "Henüz çözülmedi" %>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</div>
