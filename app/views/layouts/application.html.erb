<!DOCTYPE html>
<html lang="tr" class="h-full dark">
  <head>
    <title><%= content_for(:title) || "AbisiDesk — Bilet Yönetim Sistemi" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="AbisiDesk">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% sidebar_tickets = (Ticket.all.to_a rescue []) %>
  <% sidebar_breached = sidebar_tickets.count(&:sla_breached?) %>
  <% sidebar_open = sidebar_tickets.count { |t| t.status.in?(%w[new open]) } %>

  <body class="min-h-full bg-zinc-950 font-sans text-zinc-100 antialiased selection:bg-cyan-500/30 selection:text-cyan-200">
    <div class="flex min-h-screen">
      <!-- Sol Sabit Sidebar (Linear / Supabase / Vercel Tarzı) -->
      <aside class="hidden w-64 shrink-0 flex-col justify-between border-r border-zinc-800/80 bg-zinc-950/95 px-4 py-6 lg:flex">
        <div class="space-y-6">
          <!-- Marka Logosu -->
          <div class="px-2">
            <%= link_to root_path, class: "flex items-center gap-3 group" do %>
              <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-cyan-500 to-emerald-500 text-zinc-950 shadow-lg shadow-cyan-500/20 transition group-hover:scale-105">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                </svg>
              </span>
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-base font-bold tracking-tight text-zinc-100">AbisiDesk</span>
                  <span class="rounded border border-cyan-800/60 bg-cyan-950/60 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-cyan-400">v2.4</span>
                </div>
                <p class="text-[11px] text-zinc-500">B2B SLA & Triage Engine</p>
              </div>
            <% end %>
          </div>

          <!-- Canlı SLA Motoru Göstergesi -->
          <div class="rounded-xl border border-zinc-800/90 bg-zinc-900/70 p-3.5 backdrop-blur">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-400">Canlı SLA Durumu</span>
              <% if sidebar_breached > 0 %>
                <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-red-400">
                  <span class="relative flex h-2 w-2">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-red-400 opacity-75"></span>
                    <span class="relative inline-flex h-2 w-2 rounded-full bg-red-500"></span>
                  </span>
                  <%= sidebar_breached %> İhlal
                </span>
              <% else %>
                <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-emerald-400">
                  <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                  Nominal
                </span>
              <% end %>
            </div>
            <div class="mt-2.5 grid grid-cols-2 gap-2 border-t border-zinc-800/80 pt-2.5 text-[11px]">
              <div>
                <span class="text-zinc-500">Acil Hedef</span>
                <p class="font-semibold text-zinc-200">1 Saat SLA</p>
              </div>
              <div>
                <span class="text-zinc-500">Normal Hedef</span>
                <p class="font-semibold text-zinc-200">4 Saat SLA</p>
              </div>
            </div>
          </div>

          <!-- Ana Navigasyon -->
          <nav class="space-y-1">
            <p class="px-2.5 pb-1.5 text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Workspace</p>

            <%= link_to tickets_path, class: "flex items-center justify-between rounded-xl px-3 py-2 text-sm font-medium transition #{current_page?(root_path) || current_page?(tickets_path) ? 'bg-zinc-800/90 text-zinc-100 border border-zinc-700/70' : 'text-zinc-400 hover:bg-zinc-900 hover:text-zinc-200'}" do %>
              <span class="flex items-center gap-2.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-cyan-400" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M3.75 3A1.75 1.75 0 002 4.75v3.26a3.235 3.235 0 011.75-.51h12.5c.644 0 1.245.188 1.75.51V6.75A1.75 1.75 0 0016.25 5h-4.836a.25.25 0 01-.177-.073L9.823 3.513A1.75 1.75 0 008.586 3H3.75zM3.75 9A1.75 1.75 0 002 10.75v4.5c0 .966.784 1.75 1.75 1.75h12.5A1.75 1.75 0 0018 15.25v-4.5A1.75 1.75 0 0016.25 9H3.75z" />
                </svg>
                <span>Biletler</span>
              </span>
              <span class="rounded-md bg-zinc-900 px-2 py-0.5 text-xs font-semibold text-zinc-300 border border-zinc-800"><%= sidebar_open %></span>
            <% end %>

            <%= link_to tickets_path(anchor: "kpi-metrics"), class: "flex items-center gap-2.5 rounded-xl px-3 py-2 text-sm font-medium text-zinc-400 hover:bg-zinc-900 hover:text-zinc-200 transition" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
                <path d="M15.5 2A1.5 1.5 0 0014 3.5v13a1.5 1.5 0 001.5 1.5h1a1.5 1.5 0 001.5-1.5v-13A1.5 1.5 0 0016.5 2h-1zM9.5 6A1.5 1.5 0 008 7.5v9A1.5 1.5 0 009.5 18h1a1.5 1.5 0 001.5-1.5v-9A1.5 1.5 0 0010.5 6h-1zM3.5 10A1.5 1.5 0 002 11.5v5A1.5 1.5 0 003.5 18h1A1.5 1.5 0 006 16.5v-5A1.5 1.5 0 004.5 10h-1z" />
              </svg>
              <span>Metrikler</span>
            <% end %>

            <%= link_to tickets_path(anchor: "sla-rules"), class: "flex items-center gap-2.5 rounded-xl px-3 py-2 text-sm font-medium text-zinc-400 hover:bg-zinc-900 hover:text-zinc-200 transition" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M11.983 1.907a.75.75 0 00-1.292-.657l-8.5 9.5A.75.75 0 002.75 12h6.572l-1.305 6.093a.75.75 0 001.292.657l8.5-9.5A.75.75 0 0017.25 8h-6.572l1.305-6.093z" clip-rule="evenodd" />
              </svg>
              <span>SLA Kuralları</span>
            <% end %>
          </nav>

          <!-- Hızlı Kuyruk Filtreleri -->
          <div class="space-y-1 pt-2">
            <p class="px-2.5 pb-1.5 text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Hızlı Kuyruklar</p>

            <%= link_to tickets_path(priority: "urgent"), class: "flex items-center justify-between rounded-xl px-3 py-2 text-xs font-medium text-zinc-400 hover:bg-zinc-900 hover:text-red-300 transition" do %>
              <span class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-red-500 animate-pulse"></span>
                <span>Acil (Urgent) Kuyruğu</span>
              </span>
            <% end %>

            <%= link_to tickets_path(status: "open"), class: "flex items-center justify-between rounded-xl px-3 py-2 text-xs font-medium text-zinc-400 hover:bg-zinc-900 hover:text-amber-300 transition" do %>
              <span class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-amber-400"></span>
                <span>Açık / İncelemede</span>
              </span>
            <% end %>

            <%= link_to tickets_path(status: "solved"), class: "flex items-center justify-between rounded-xl px-3 py-2 text-xs font-medium text-zinc-400 hover:bg-zinc-900 hover:text-emerald-300 transition" do %>
              <span class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                <span>Çözülen Biletler</span>
              </span>
            <% end %>
          </div>
        </div>

        <!-- Alt Sidebar Aksiyonu -->
        <div class="space-y-3 border-t border-zinc-800/80 pt-4">
          <%= link_to new_ticket_path, class: "flex w-full items-center justify-center gap-2 rounded-xl bg-cyan-600 px-4 py-2.5 text-xs font-semibold text-white shadow-lg shadow-cyan-600/20 hover:bg-cyan-500 transition" do %>
            <span>+ Yeni Bilet Oluştur</span>
          <% end %>
        </div>
      </aside>

      <!-- Sağ Ana İçerik Alanı -->
      <div class="flex min-w-0 flex-1 flex-col">
        <!-- Üst Karşılama, Arama ve Aksiyon Barı -->
        <header class="sticky top-0 z-20 border-b border-zinc-800/80 bg-zinc-950/80 backdrop-blur-md">
          <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6 lg:px-8">
            <div class="flex items-center gap-3">
              <!-- Mobil Logo -->
              <%= link_to root_path, class: "flex items-center gap-2 lg:hidden" do %>
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-cyan-500 text-zinc-950 font-bold">A</span>
                <span class="text-base font-bold text-zinc-100">AbisiDesk</span>
              <% end %>

              <div class="hidden sm:block">
                <div class="flex items-center gap-2 text-xs font-medium text-zinc-400">
                  <span>AbisiDesk Cloud</span>
                  <span class="text-zinc-700">/</span>
                  <span class="text-zinc-200 font-semibold">Destek Operasyon Merkezi</span>
                </div>
              </div>
            </div>

            <!-- Arama Çubuğu ve + Yeni Bilet Butonu -->
            <div class="flex flex-1 items-center justify-end gap-3 max-w-md">
              <%= form_with url: tickets_path, method: :get, local: true, class: "relative flex-1" do |f| %>
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-zinc-500">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
                  </svg>
                </div>
                <%= f.text_field :q,
                      value: params[:q],
                      placeholder: "Bilet veya e-posta ara...",
                      class: "w-full rounded-xl border border-zinc-800 bg-zinc-900/90 py-1.5 pl-9 pr-3 text-xs text-zinc-100 placeholder:text-zinc-500 focus:border-cyan-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/20" %>
              <% end %>

              <%= link_to new_ticket_path, class: "inline-flex shrink-0 items-center gap-1.5 rounded-xl bg-cyan-600 px-3.5 py-2 text-xs font-semibold text-white shadow-sm shadow-cyan-600/20 hover:bg-cyan-500 transition" do %>
                <span>+ Yeni Bilet</span>
              <% end %>
            </div>
          </div>
        </header>

        <!-- Flash Bildirimleri -->
        <div class="mx-auto w-full max-w-7xl px-4 pt-5 sm:px-6 lg:px-8">
          <% if notice.present? %>
            <div role="alert" class="mb-6 flex items-center justify-between rounded-xl border border-emerald-800/60 bg-emerald-950/60 px-4 py-3 text-sm font-medium text-emerald-300 backdrop-blur">
              <div class="flex items-center gap-2.5">
                <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                <span><%= notice %></span>
              </div>
            </div>
          <% end %>

          <% if alert.present? %>
            <div role="alert" class="mb-6 flex items-center justify-between rounded-xl border border-red-800/60 bg-red-950/60 px-4 py-3 text-sm font-medium text-red-300 backdrop-blur">
              <div class="flex items-center gap-2.5">
                <span class="h-2 w-2 rounded-full bg-red-400 animate-ping"></span>
                <span><%= alert %></span>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Sayfa İçeriği -->
        <main class="mx-auto w-full max-w-7xl flex-1 px-4 pb-12 sm:px-6 lg:px-8">
          <%= yield %>
        </main>

        <!-- Alt Bilgi (Footer) -->
        <footer class="border-t border-zinc-800/80 bg-zinc-950/80 px-4 py-4 sm:px-6 lg:px-8">
          <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-2 text-xs text-zinc-500 sm:flex-row">
            <span>&copy; <%= Time.current.year %> <strong class="font-semibold text-zinc-300">AbisiDesk</strong> — Kurumsal SLA & Yapay Zeka Destek Sistemi</span>
            <span>Telegram AI Bot: <strong class="font-mono text-cyan-400">@Abisinin_Destek_Bot</strong></span>
          </div>
        </footer>
      </div>
    </div>
  </body>
</html>
