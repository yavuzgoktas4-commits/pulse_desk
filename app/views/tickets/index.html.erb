<% content_for :title, "PulseDesk — Bilet Yönetim Sistemi" %>

<% all_tickets = Ticket.all.to_a %>
<% total_count = all_tickets.size %>
<% open_count = all_tickets.count { |t| t.status.in?(%w[new open]) } %>
<% breached_count = all_tickets.count(&:sla_breached?) %>
<% critical_or_breached_count = all_tickets.count { |t| t.sla_breached? || (t.status != "solved" && t.priority.in?(%w[urgent high])) } %>
<% solved_count = all_tickets.count { |t| t.status == "solved" } %>

<div class="space-y-8">
  <!-- Üst Başlık Alanı -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <div class="inline-flex items-center gap-2 rounded-full border border-cyan-800/50 bg-cyan-950/50 px-3 py-1 text-xs font-medium text-cyan-400 mb-2.5">
        <span class="h-1.5 w-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
        Otomatik SLA & Akıllı Triyaj Aktif
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-zinc-100 sm:text-3xl">Destek Biletleri</h1>
      <p class="mt-1 text-sm text-zinc-400">
        Gelen kurumsal talepleri gerçek zamanlı SLA hedefleri ve aciliyet önceliklerine göre izleyin.
      </p>
    </div>

    <div class="flex items-center gap-3">
      <%= link_to new_ticket_path, class: "inline-flex items-center justify-center gap-2 rounded-xl bg-cyan-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-cyan-600/20 transition hover:bg-cyan-500 focus:outline-none focus:ring-4 focus:ring-cyan-500/20" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
        </svg>
        <span>+ Yeni Bilet</span>
      <% end %>
    </div>
  </div>

  <!-- 4 Adet Koyu Cam (Glassmorphism) KPI Kartı -->
  <div id="kpi-metrics" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <!-- 1. Toplam Bilet -->
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/80 p-5 backdrop-blur transition hover:border-zinc-700">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Toplam Bilet</span>
        <span class="flex h-9 w-9 items-center justify-center rounded-xl border border-zinc-700/80 bg-zinc-800/80 text-zinc-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path d="M3.75 3A1.75 1.75 0 002 4.75v3.26a3.235 3.235 0 011.75-.51h12.5c.644 0 1.245.188 1.75.51V6.75A1.75 1.75 0 0016.25 5h-4.836a.25.25 0 01-.177-.073L9.823 3.513A1.75 1.75 0 008.586 3H3.75zM3.75 9A1.75 1.75 0 002 10.75v4.5c0 .966.784 1.75 1.75 1.75h12.5A1.75 1.75 0 0018 15.25v-4.5A1.75 1.75 0 0016.25 9H3.75z" />
          </svg>
        </span>
      </div>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="text-3xl font-bold tracking-tight text-zinc-100"><%= total_count %></span>
        <span class="text-xs text-zinc-400">toplam kayıt</span>
      </div>
    </div>

    <!-- 2. Açık Biletler -->
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/80 p-5 backdrop-blur transition hover:border-amber-800/60">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Açık Biletler</span>
        <span class="flex h-9 w-9 items-center justify-center rounded-xl border border-amber-800/50 bg-amber-950/60 text-amber-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-13a.75.75 0 00-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 000-1.5h-3.25V5z" clip-rule="evenodd" />
          </svg>
        </span>
      </div>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="text-3xl font-bold tracking-tight text-zinc-100"><%= open_count %></span>
        <span class="text-xs text-amber-400">aktif kuyrukta</span>
      </div>
    </div>

    <!-- 3. SLA İhlali / Kritik Biletler (Neon Kırmızı Vurgulu) -->
    <div class="rounded-2xl border border-red-800/60 bg-gradient-to-br from-red-950/60 via-zinc-900/90 to-zinc-900/80 p-5 backdrop-blur transition hover:border-red-700">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-red-400">SLA İhlali / Kritik</span>
        <span class="relative flex h-9 w-9 items-center justify-center rounded-xl border border-red-800/60 bg-red-950/80 text-red-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
          </svg>
        </span>
      </div>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="text-3xl font-extrabold tracking-tight text-red-400"><%= critical_or_breached_count %></span>
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-red-400">
          <span class="h-2 w-2 rounded-full bg-red-500 animate-ping"></span>
          <%= breached_count %> SLA İhlali
        </span>
      </div>
    </div>

    <!-- 4. Çözülen Biletler -->
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/80 p-5 backdrop-blur transition hover:border-emerald-800/60">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Çözülen Biletler</span>
        <span class="flex h-9 w-9 items-center justify-center rounded-xl border border-emerald-800/50 bg-emerald-950/60 text-emerald-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
          </svg>
        </span>
      </div>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="text-3xl font-bold tracking-tight text-zinc-100"><%= solved_count %></span>
        <span class="text-xs text-emerald-400">başarıyla çözüldü</span>
      </div>
    </div>
  </div>

  <!-- Filtreleme Sekmeleri (Koyu Hap / Pill Butonlar) -->
  <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-zinc-800 bg-zinc-900/70 px-4 py-3 backdrop-blur">
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to "Tümü", tickets_path, class: "rounded-full px-3.5 py-1.5 text-xs font-semibold transition #{params[:status].blank? && params[:priority].blank? ? 'bg-cyan-600 text-white shadow-sm shadow-cyan-500/30' : 'bg-zinc-950/70 text-zinc-400 border border-zinc-800 hover:border-zinc-700 hover:text-zinc-200'}" %>
      <%= link_to "Açık (Open)", tickets_path(status: "open"), class: "rounded-full px-3.5 py-1.5 text-xs font-semibold transition #{params[:status] == 'open' ? 'bg-amber-600 text-white' : 'bg-zinc-950/70 text-zinc-400 border border-zinc-800 hover:border-amber-800/60 hover:text-amber-300'}" %>
      <%= link_to "Yeni (New)", tickets_path(status: "new"), class: "rounded-full px-3.5 py-1.5 text-xs font-semibold transition #{params[:status] == 'new' ? 'bg-cyan-600 text-white' : 'bg-zinc-950/70 text-zinc-400 border border-zinc-800 hover:border-cyan-800/60 hover:text-cyan-300'}" %>
      <%= link_to "Acil (Urgent)", tickets_path(priority: "urgent"), class: "rounded-full px-3.5 py-1.5 text-xs font-semibold transition #{params[:priority] == 'urgent' ? 'bg-red-600 text-white' : 'bg-red-950/40 text-red-400 border border-red-800/50 hover:bg-red-950/80'}" %>
      <%= link_to "Çözülenler (Solved)", tickets_path(status: "solved"), class: "rounded-full px-3.5 py-1.5 text-xs font-semibold transition #{params[:status] == 'solved' ? 'bg-emerald-600 text-white' : 'bg-zinc-950/70 text-zinc-400 border border-zinc-800 hover:border-emerald-800/60 hover:text-emerald-300'}" %>
    </div>

    <div class="text-xs text-zinc-400">
      Toplam <span class="font-semibold text-zinc-100"><%= @tickets.count %></span> bilet listeleniyor
    </div>
  </div>

  <!-- Koyu Tema Bilet Listesi Tablosu -->
  <% if @tickets.any? %>
    <div class="overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/80 backdrop-blur">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-zinc-800">
          <thead>
            <tr class="bg-zinc-950/60">
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-wider text-zinc-400">Bilet & Müşteri</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-wider text-zinc-400">Durum</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-wider text-zinc-400">Öncelik</th>
              <th scope="col" class="px-6 py-4 text-left text-[11px] font-semibold uppercase tracking-wider text-zinc-400">SLA Durumu & Kalan Süre</th>
              <th scope="col" class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-wider text-zinc-400">İşlem</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-800/70">
            <% @tickets.each do |ticket| %>
              <% breached = ticket.sla_breached? %>
              <tr class="group transition duration-150 <%= breached ? 'bg-red-950/20 hover:bg-red-950/40' : 'hover:bg-zinc-800/50' %>">
                <!-- Bilet Başlığı ve Müşteri -->
                <td class="px-6 py-5">
                  <div class="flex items-start gap-3.5">
                    <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border text-xs font-bold uppercase <%= breached ? 'border-red-800/60 bg-red-950/70 text-red-400' : 'border-zinc-700/80 bg-zinc-800 text-zinc-300' %>">
                      <%= ticket.customer_email.to_s[0..1] %>
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-2.5">
                        <%= link_to ticket.title, ticket_path(ticket), class: "text-sm font-semibold text-zinc-100 group-hover:text-cyan-400 transition" %>
                        <% if breached %>
                          <span class="inline-flex items-center gap-1.5 rounded-full border border-red-800/60 bg-red-950/80 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide text-red-400">
                            <span class="h-1.5 w-1.5 rounded-full bg-red-500 animate-ping"></span>
                            SLA İHLALİ / BREACHED
                          </span>
                        <% end %>
                      </div>
                      <div class="mt-1.5 flex flex-wrap items-center gap-2 text-xs text-zinc-400">
                        <span class="font-medium text-zinc-300"><%= ticket.customer_email %></span>
                        <span class="text-zinc-600">&bull;</span>
                        <span class="font-mono text-zinc-500">#<%= ticket.id %></span>
                        <span class="text-zinc-600">&bull;</span>
                        <span><%= ticket.created_at.strftime("%d.%m.%Y %H:%M") %></span>
                      </div>
                    </div>
                  </div>
                </td>

                <!-- Durum -->
                <td class="whitespace-nowrap px-6 py-5">
                  <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(ticket.status) %>">
                    <span class="h-1.5 w-1.5 rounded-full <%= status_dot_classes(ticket.status) %>"></span>
                    <%= status_label(ticket.status) %>
                  </span>
                </td>

                <!-- Öncelik -->
                <td class="whitespace-nowrap px-6 py-5">
                  <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs <%= priority_badge_classes(ticket.priority) %>">
                    <span class="h-1.5 w-1.5 rounded-full <%= priority_dot_classes(ticket.priority) %>"></span>
                    <%= priority_label(ticket.priority) %>
                  </span>
                </td>

                <!-- SLA Durumu -->
                <td class="whitespace-nowrap px-6 py-5">
                  <div class="flex flex-col items-start gap-1">
                    <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs <%= sla_badge_classes(ticket) %>">
                      <% if breached %>
                        <span class="h-1.5 w-1.5 rounded-full bg-red-400 animate-ping"></span>
                      <% elsif ticket.status == "solved" %>
                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                      <% else %>
                        <span class="h-1.5 w-1.5 rounded-full bg-cyan-400"></span>
                      <% end %>
                      <%= remaining_sla_text(ticket) %>
                    </span>
                    <% if ticket.sla_deadline.present? && ticket.status != "solved" %>
                      <span class="pl-1 text-[11px] text-zinc-500">
                        Hedef: <%= ticket.sla_deadline.strftime("%d.%m.%Y %H:%M") %>
                      </span>
                    <% end %>
                  </div>
                </td>

                <!-- İşlem -->
                <td class="whitespace-nowrap px-6 py-5 text-right">
                  <%= link_to ticket_path(ticket), class: "inline-flex items-center gap-1.5 rounded-xl border border-zinc-700/80 bg-zinc-900 px-3.5 py-2 text-xs font-semibold text-zinc-200 transition hover:border-cyan-500/60 hover:bg-cyan-950/40 hover:text-cyan-300" do %>
                    <span>Detay</span>
                    <span aria-hidden="true">&rarr;</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-zinc-800 bg-zinc-900/60 p-14 text-center backdrop-blur">
      <h3 class="text-base font-semibold text-zinc-100">Eşleşen destek bileti bulunamadı</h3>
      <p class="mt-1 text-sm text-zinc-400">Seçili filtreye uygun kayıt yok veya henüz yeni bir bilet açılmadı.</p>
      <div class="mt-6">
        <%= link_to "+ Yeni Bilet Oluştur", new_ticket_path, class: "inline-flex items-center rounded-xl bg-cyan-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-cyan-500 transition" %>
      </div>
    </div>
  <% end %>

  <!-- SLA Kuralları Bilgi Kartı -->
  <div id="sla-rules" class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6 backdrop-blur">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-sm font-bold uppercase tracking-wider text-cyan-400">PulseDesk Otomatik SLA Motoru Kuralları</h2>
        <p class="mt-1 text-xs text-zinc-400">
          Bilet oluşturulurken başlık ve açıklama metni gerçek zamanlı taranarak aşağıdaki SLA politikaları otomatik uygulanır:
        </p>
      </div>
      <div class="flex flex-wrap gap-3 text-xs">
        <span class="rounded-xl border border-red-800/50 bg-red-950/60 px-3.5 py-2 text-red-300">
          <strong>Urgent (1 Saat SLA):</strong> çöktü, acil, ödeme, hata, down, critical
        </span>
        <span class="rounded-xl border border-zinc-700 bg-zinc-800/80 px-3.5 py-2 text-zinc-300">
          <strong>Normal (4 Saat SLA):</strong> Diğer tüm standart destek talepleri
        </span>
      </div>
    </div>
  </div>
</div>
