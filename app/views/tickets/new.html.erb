<% content_for :title, "PulseDesk — Yeni Destek Bileti" %>

<div class="mx-auto max-w-2xl space-y-6">
  <!-- Üst Geri Dönüş -->
  <div>
    <%= link_to tickets_path, class: "inline-flex items-center gap-2 rounded-xl border border-zinc-800 bg-zinc-900/80 px-3.5 py-2 text-xs font-semibold text-zinc-300 transition hover:border-zinc-700 hover:bg-zinc-800 hover:text-zinc-100" do %>
      <span aria-hidden="true">&larr;</span>
      <span>Bilet Listesine Dön</span>
    <% end %>
  </div>

  <!-- Koyu Tema Form Kartı -->
  <div class="overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/80 backdrop-blur">
    <div class="border-b border-zinc-800 bg-zinc-950/50 px-6 py-6 sm:px-8">
      <div class="flex items-center gap-3.5">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-cyan-600 text-white shadow-lg shadow-cyan-600/20">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
          </svg>
        </span>
        <div>
          <h1 class="text-xl font-bold tracking-tight text-zinc-100">Yeni Destek Bileti Oluştur</h1>
          <p class="mt-0.5 text-xs text-zinc-400">
            Bilet içeriği analiz edilerek aciliyet önceliği ve SLA hedefi otomatik belirlenir.
          </p>
        </div>
      </div>
    </div>

    <div class="p-6 sm:p-8 space-y-6">
      <!-- Akıllı SLA Bilgilendirme Bandı -->
      <div class="rounded-xl border border-cyan-800/50 bg-cyan-950/40 p-4 text-xs leading-relaxed text-cyan-200">
        <p class="font-semibold text-cyan-300">Otomatik Öncelik & SLA Triyaj Kuralı:</p>
        <p class="mt-1 text-zinc-300">
          Başlık veya açıklamada <code class="rounded border border-cyan-800 bg-zinc-950 px-1.5 py-0.5 font-mono text-cyan-300">çöktü, acil, ödeme, hata, down, critical</code>
          kelimelerinden biri geçerse bilet <strong>Acil (Urgent — 1 Saat SLA)</strong>, aksi durumda <strong>Normal (4 Saat SLA)</strong> olarak açılır.
        </p>
      </div>

      <%= form_with model: @ticket, class: "space-y-5" do |f| %>
        <% if @ticket.errors.any? %>
          <div class="rounded-xl border border-red-800/60 bg-red-950/60 p-4 text-sm text-red-300">
            <p class="font-semibold"><%= @ticket.errors.count %> hata nedeniyle bilet kaydedilemedi:</p>
            <ul class="mt-2 list-disc pl-5 space-y-1 text-xs">
              <% @ticket.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :title, "Bilet Konu Başlığı", class: "block text-sm font-semibold text-zinc-100" %>
          <p class="mt-0.5 text-xs text-zinc-400">Yaşanan teknik veya operasyonel sorunu özetleyin.</p>
          <%= f.text_field :title,
                required: true,
                placeholder: "Örn: ACİL — Kurumsal ödeme sayfasında 502 Bad Gateway hatası alıyoruz",
                class: "mt-2 block w-full rounded-xl border border-zinc-800 bg-zinc-950 px-4 py-2.5 text-sm text-white placeholder:text-zinc-500 transition focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30" %>
        </div>

        <div>
          <%= f.label :customer_email, "Müşteri Kurumsal E-posta Adresi", class: "block text-sm font-semibold text-zinc-100" %>
          <p class="mt-0.5 text-xs text-zinc-400">SLA takibinin ilişkilendirileceği müşteri e-postası.</p>
          <%= f.email_field :customer_email,
                required: true,
                placeholder: "cto@kurumsalsirket.com.tr",
                class: "mt-2 block w-full rounded-xl border border-zinc-800 bg-zinc-950 px-4 py-2.5 text-sm text-white placeholder:text-zinc-500 transition focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30" %>
        </div>

        <div>
          <%= f.label :description, "Detaylı Sorun Açıklaması", class: "block text-sm font-semibold text-zinc-100" %>
          <p class="mt-0.5 text-xs text-zinc-400">Hata mesajlarını ve etkilenen sistemleri belirtin.</p>
          <%= f.text_area :description,
                rows: 5,
                required: true,
                placeholder: "Canlı ortamda SSO entegrasyonu çöktü, kullanıcılar giriş yaparken hata alıyor...",
                class: "mt-2 block w-full rounded-xl border border-zinc-800 bg-zinc-950 px-4 py-2.5 text-sm text-white placeholder:text-zinc-500 transition focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30" %>
        </div>

        <div class="flex items-center justify-end gap-3 border-t border-zinc-800 pt-5">
          <%= link_to "İptal", tickets_path, class: "rounded-xl border border-zinc-800 bg-zinc-950 px-4 py-2.5 text-sm font-semibold text-zinc-300 hover:bg-zinc-800 hover:text-white transition" %>
          <%= f.submit "+ Bileti Oluştur ve SLA Başlat", class: "cursor-pointer rounded-xl bg-cyan-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-cyan-600/20 transition hover:bg-cyan-500 focus:outline-none focus:ring-4 focus:ring-cyan-500/20" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
