<% content_for :title, "PulseDesk — Bilet ##{@ticket.id}: #{@ticket.title}" %>
<% breached = @ticket.sla_breached? %>

<div class="mx-auto max-w-4xl space-y-6">
  <!-- Üst Geri Dönüş Barı -->
  <div class="flex items-center justify-between">
    <%= link_to tickets_path, class: "inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 shadow-2xs transition hover:border-slate-300 hover:bg-slate-50" do %>
      <span aria-hidden="true">&larr;</span>
      <span>Bilet Listesine Dön</span>
    <% end %>

    <span class="rounded-lg bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
      Bilet #<%= @ticket.id %>
    </span>
  </div>

  <!-- SLA İhlali Uyarı Bandı -->
  <% if breached %>
    <div class="flex flex-col gap-3 rounded-2xl border border-red-300 bg-gradient-to-r from-red-50 via-rose-50 to-white p-5 shadow-xs sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-start gap-3.5">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-red-600 text-white shadow-xs">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
          </svg>
        </span>
        <div>
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center rounded-full bg-red-600 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-white">
              SLA İHLALİ / BREACHED
            </span>
            <span class="text-sm font-bold text-red-900">Hedef çözüm süresi aşıldı!</span>
          </div>
          <p class="mt-1 text-xs text-red-700">
            SLA Hedef Zamanı: <strong><%= @ticket.sla_deadline&.strftime("%d.%m.%Y %H:%M") %></strong> &middot; <%= remaining_sla_text(@ticket) %>
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Ortalanmış Modern Bilet Detay Kartı -->
  <div class="overflow-hidden rounded-2xl border border-slate-200/90 bg-white shadow-sm">
    <!-- Kart Başlığı -->
    <div class="border-b border-slate-200/80 bg-slate-50/60 p-6 sm:p-8">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
        <div class="space-y-3">
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(@ticket.status) %>">
              <span class="h-1.5 w-1.5 rounded-full <%= status_dot_classes(@ticket.status) %>"></span>
              <%= status_label(@ticket.status) %>
            </span>

            <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs <%= priority_badge_classes(@ticket.priority) %>">
              <span class="h-1.5 w-1.5 rounded-full <%= priority_dot_classes(@ticket.priority) %>"></span>
              Öncelik: <%= priority_label(@ticket.priority) %>
            </span>

            <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs <%= sla_badge_classes(@ticket) %>">
              <%= remaining_sla_text(@ticket) %>
            </span>
          </div>

          <h1 class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">
            <%= @ticket.title %>
          </h1>

          <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500">
            <span class="inline-flex items-center gap-1.5 font-medium text-slate-700">
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-indigo-100 text-[10px] font-bold uppercase text-indigo-700">
                <%= @ticket.customer_email.to_s[0..1] %>
              </span>
              <%= @ticket.customer_email %>
            </span>
            <span>&bull;</span>
            <span>Oluşturulma: <%= @ticket.created_at.strftime("%d.%m.%Y %H:%M") %></span>
          </div>
        </div>

        <!-- Durum Geçiş Butonları -->
        <div class="flex flex-wrap items-center gap-2.5 shrink-0">
          <% if @ticket.status != "open" %>
            <%= button_to "İncelemeye Al (Open)",
                  mark_as_open_ticket_path(@ticket),
                  method: :patch,
                  class: "inline-flex cursor-pointer items-center justify-center rounded-xl border border-amber-300 bg-amber-500 px-4 py-2.5 text-xs font-semibold text-white shadow-2xs transition hover:bg-amber-600 focus:outline-none focus:ring-4 focus:ring-amber-500/20" %>
          <% end %>

          <% if @ticket.status != "solved" %>
            <%= button_to "Çözüldü Olarak İşaretle (Solved)",
                  mark_as_solved_ticket_path(@ticket),
                  method: :patch,
                  class: "inline-flex cursor-pointer items-center justify-center rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-semibold text-white shadow-2xs transition hover:bg-emerald-700 focus:outline-none focus:ring-4 focus:ring-emerald-500/20" %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Kart Gövdesi: Sorun Açıklaması ve SLA Özeti -->
    <div class="grid grid-cols-1 divide-y divide-slate-200/80 lg:grid-cols-3 lg:divide-x lg:divide-y-0">
      <div class="p-6 sm:p-8 lg:col-span-2">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Müşteri Bildirimi & Sorun Detayı</h2>
        <div class="mt-4 whitespace-pre-line rounded-2xl border border-slate-200/70 bg-slate-50/70 p-5 text-sm leading-relaxed text-slate-800">
          <%= @ticket.description %>
        </div>
      </div>

      <div class="bg-slate-50/40 p-6 sm:p-8 space-y-5">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400">SLA & Operasyonel Bilgiler</h2>

        <dl class="space-y-4 text-sm">
          <div class="rounded-xl border border-slate-200/80 bg-white p-3.5">
            <dt class="text-xs font-medium text-slate-400">SLA Durumu</dt>
            <dd class="mt-1">
              <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs <%= sla_badge_classes(@ticket) %>">
                <%= remaining_sla_text(@ticket) %>
              </span>
            </dd>
          </div>

          <div class="rounded-xl border border-slate-200/80 bg-white p-3.5">
            <dt class="text-xs font-medium text-slate-400">SLA Bitiş Hedefi</dt>
            <dd class="mt-1 font-semibold text-slate-900">
              <%= @ticket.sla_deadline ? @ticket.sla_deadline.strftime("%d.%m.%Y %H:%M") : "-" %>
            </dd>
          </div>

          <div class="rounded-xl border border-slate-200/80 bg-white p-3.5">
            <dt class="text-xs font-medium text-slate-400">Çözülme Zamanı</dt>
            <dd class="mt-1 font-semibold <%= @ticket.resolved_at ? 'text-emerald-700' : 'text-slate-500' %>">
              <%= @ticket.resolved_at ? @ticket.resolved_at.strftime("%d.%m.%Y %H:%M") : "Henüz çözülmedi" %>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</div>
