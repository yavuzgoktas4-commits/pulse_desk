<% content_for :title, "PulseDesk — Bilet Yönetim Sistemi" %>

<% all_tickets = Ticket.all.to_a %>
<% total_count = all_tickets.size %>
<% open_count = all_tickets.count { |t| t.status.in?(%w[new open]) } %>
<% breached_count = all_tickets.count(&:sla_breached?) %>
<% critical_or_breached_count = all_tickets.count { |t| t.sla_breached? || (t.status != "solved" && t.priority.in?(%w[urgent high])) } %>
<% solved_count = all_tickets.count { |t| t.status == "solved" } %>

<div class="space-y-8">
  <!-- Sayfa Başlığı ve Primary Aksiyon -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <div class="inline-flex items-center gap-2 rounded-full border border-indigo-200/80 bg-indigo-50/80 px-3 py-1 text-xs font-semibold text-indigo-700 mb-2">
        <span class="h-1.5 w-1.5 rounded-full bg-indigo-600"></span>
        Gerçek Zamanlı SLA & Triyaj Motoru
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Müşteri Destek Biletleri</h1>
      <p class="mt-1 text-sm text-slate-500">
        Gelen B2B destek taleplerini öncelik, kalan SLA hedefi ve çözüm durumuna göre tek ekrandan yönetin.
      </p>
    </div>

    <div class="flex items-center gap-3">
      <%= link_to new_ticket_path, class: "inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm ring-1 ring-indigo-600 transition hover:bg-indigo-700 hover:shadow focus:outline-none focus:ring-4 focus:ring-indigo-500/20" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
        </svg>
        <span>+ Yeni Bilet</span>
      <% end %>
    </div>
  </div>

  <!-- 4 Adet KPI / Metrik Kartı (Linear / Stripe Tarzı) -->
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <!-- 1. Toplam Bilet -->
    <div class="group relative overflow-hidden rounded-2xl border border-slate-200/90 bg-white p-5 shadow-2xs transition hover:border-slate-300 hover:shadow-sm">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Toplam Bilet</span>
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-slate-100 text-slate-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M3.75 3A1.75 1.75 0 002 4.75v3.26a3.235 3.235 0 011.75-.51h12.5c.644 0 1.245.188 1.75.51V6.75A1.75 1.75 0 0016.25 5h-4.836a.25.25 0 01-.177-.073L9.823 3.513A1.75 1.75 0 008.586 3H3.75zM3.75 9A1.75 1.75 0 002 10.75v4.5c0 .966.784 1.75 1.75 1.75h12.5A1.75 1.75 0 0018 15.25v-4.5A1.75 1.75 0 0016.25 9H3.75z" />
          </svg>
        </span>
      </div>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="text-3xl font-bold tracking-tight text-slate-900"><%= total_count %></span>
        <span class="text-xs font-medium text-slate-500">kayıtlı talep</span>
      </div>
    </div>

    <!-- 2. Açık Biletler -->
    <div class="group relative overflow-hidden rounded-2xl border border-slate-200/90 bg-white p-5 shadow-2xs transition hover:border-indigo-200 hover:shadow-sm">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Açık Biletler</span>
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-13a.75.75 0 00-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 000-1.5h-3.25V5z" clip-rule="evenodd" />
          </svg>
        </span>
      </div>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="text-3xl font-bold tracking-tight text-slate-900"><%= open_count %></span>
        <span class="text-xs font-medium text-indigo-600">aktif işlemde</span>
      </div>
    </div>

    <!-- 3. SLA İhlali / Kritik Biletler (Kırmızı Vurgulu) -->
    <div class="group relative overflow-hidden rounded-2xl border-2 border-red-200 bg-gradient-to-br from-red-50 via-rose-50/70 to-white p-5 shadow-2xs transition hover:border-red-300 hover:shadow-sm">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-red-700">SLA İhlali / Kritik Biletler</span>
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-red-100 text-red-600 ring-1 ring-red-200">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
          </svg>
        </span>
      </div>
      <div class="mt-3 flex items-baseline justify-between">
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-extrabold tracking-tight text-red-700"><%= critical_or_breached_count %></span>
          <span class="text-xs font-semibold text-red-700">(<%= breached_count %> SLA İhlali)</span>
        </div>
      </div>
    </div>

    <!-- 4. Çözülen Biletler -->
    <div class="group relative overflow-hidden rounded-2xl border border-slate-200/90 bg-white p-5 shadow-2xs transition hover:border-emerald-200 hover:shadow-sm">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Çözülen Biletler</span>
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
          </svg>
        </span>
      </div>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="text-3xl font-bold tracking-tight text-slate-900"><%= solved_count %></span>
        <span class="text-xs font-medium text-emerald-600">tamamlandı</span>
      </div>
    </div>
  </div>

  <!-- Filtre Barı -->
  <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200/80 bg-white px-4 py-3 shadow-2xs">
    <div class="flex flex-wrap items-center gap-1.5">
      <%= link_to "Tüm Biletler", tickets_path, class: "rounded-lg px-3 py-1.5 text-xs font-semibold transition #{params[:status].blank? && params[:priority].blank? ? 'bg-slate-900 text-white shadow-2xs' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" %>
      <%= link_to "Yeni (New)", tickets_path(status: "new"), class: "rounded-lg px-3 py-1.5 text-xs font-semibold transition #{params[:status] == 'new' ? 'bg-sky-600 text-white shadow-2xs' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" %>
      <%= link_to "Açık (Open)", tickets_path(status: "open"), class: "rounded-lg px-3 py-1.5 text-xs font-semibold transition #{params[:status] == 'open' ? 'bg-amber-600 text-white shadow-2xs' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" %>
      <%= link_to "Çözülenler (Solved)", tickets_path(status: "solved"), class: "rounded-lg px-3 py-1.5 text-xs font-semibold transition #{params[:status] == 'solved' ? 'bg-emerald-600 text-white shadow-2xs' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" %>
      <span class="mx-1 h-4 w-px bg-slate-200"></span>
      <%= link_to "Acil (Urgent)", tickets_path(priority: "urgent"), class: "rounded-lg px-3 py-1.5 text-xs font-semibold transition #{params[:priority] == 'urgent' ? 'bg-red-600 text-white shadow-2xs' : 'text-red-700 hover:bg-red-50'}" %>
      <%= link_to "Yüksek (High)", tickets_path(priority: "high"), class: "rounded-lg px-3 py-1.5 text-xs font-semibold transition #{params[:priority] == 'high' ? 'bg-orange-600 text-white shadow-2xs' : 'text-orange-700 hover:bg-orange-50'}" %>
    </div>

    <div class="text-xs font-medium text-slate-400">
      Gösterilen: <span class="font-semibold text-slate-700"><%= @tickets.count %></span> bilet
    </div>
  </div>

  <!-- Modern Bilet Tablosu -->
  <% if @tickets.any? %>
    <div class="overflow-hidden rounded-2xl border border-slate-200/90 bg-white shadow-xs">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200/80">
          <thead>
            <tr class="bg-slate-50/80">
              <th scope="col" class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Bilet & Müşteri</th>
              <th scope="col" class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Durum</th>
              <th scope="col" class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Öncelik</th>
              <th scope="col" class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">SLA Durumu & Kalan Süre</th>
              <th scope="col" class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Aksiyon</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% @tickets.each do |ticket| %>
              <% breached = ticket.sla_breached? %>
              <tr class="group transition duration-150 <%= breached ? 'bg-red-50/40 hover:bg-red-50/80' : 'hover:bg-slate-50/90' %>">
                <!-- Bilet Başlığı ve Müşteri -->
                <td class="px-6 py-5">
                  <div class="flex items-start gap-3.5">
                    <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border text-xs font-bold uppercase <%= breached ? 'border-red-200 bg-red-100 text-red-700' : 'border-slate-200 bg-slate-100 text-slate-700' %>">
                      <%= ticket.customer_email.to_s[0..1] %>
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-2">
                        <%= link_to ticket.title, ticket_path(ticket), class: "text-sm font-semibold text-slate-900 group-hover:text-indigo-600 transition" %>
                        <% if breached %>
                          <span class="inline-flex items-center gap-1 rounded-full bg-red-600 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide text-white shadow-2xs">
                            SLA İHLALİ / BREACHED
                          </span>
                        <% end %>
                      </div>
                      <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-slate-500">
                        <span class="font-medium text-slate-600"><%= ticket.customer_email %></span>
                        <span>&bull;</span>
                        <span>#<%= ticket.id %></span>
                        <span>&bull;</span>
                        <span><%= ticket.created_at.strftime("%d.%m.%Y %H:%M") %></span>
                      </div>
                    </div>
                  </div>
                </td>

                <!-- Durum (Status Pill) -->
                <td class="whitespace-nowrap px-6 py-5">
                  <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(ticket.status) %>">
                    <span class="h-1.5 w-1.5 rounded-full <%= status_dot_classes(ticket.status) %>"></span>
                    <%= status_label(ticket.status) %>
                  </span>
                </td>

                <!-- Öncelik (Priority Pill) -->
                <td class="whitespace-nowrap px-6 py-5">
                  <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs <%= priority_badge_classes(ticket.priority) %>">
                    <span class="h-1.5 w-1.5 rounded-full <%= priority_dot_classes(ticket.priority) %>"></span>
                    <%= priority_label(ticket.priority) %>
                  </span>
                </td>

                <!-- SLA Durumu Rozeti -->
                <td class="whitespace-nowrap px-6 py-5">
                  <div class="flex flex-col items-start gap-1">
                    <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs <%= sla_badge_classes(ticket) %>">
                      <% if breached %>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-red-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                        </svg>
                      <% elsif ticket.status == "solved" %>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-emerald-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                        </svg>
                      <% else %>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 opacity-75 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-13a.75.75 0 00-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 000-1.5h-3.25V5z" clip-rule="evenodd" />
                        </svg>
                      <% end %>
                      <%= remaining_sla_text(ticket) %>
                    </span>
                    <% if ticket.sla_deadline.present? && ticket.status != "solved" %>
                      <span class="pl-1 text-[11px] text-slate-400">
                        SLA Hedefi: <%= ticket.sla_deadline.strftime("%d.%m.%Y %H:%M") %>
                      </span>
                    <% end %>
                  </div>
                </td>

                <!-- Aksiyon -->
                <td class="whitespace-nowrap px-6 py-5 text-right">
                  <%= link_to ticket_path(ticket), class: "inline-flex items-center gap-1 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 shadow-2xs transition hover:border-indigo-200 hover:bg-indigo-50/50 hover:text-indigo-600" do %>
                    <span>İncele</span>
                    <span aria-hidden="true">&rarr;</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-14 text-center shadow-2xs">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <h3 class="mt-4 text-base font-semibold text-slate-900">Kayıtlı destek bileti bulunamadı</h3>
      <p class="mt-1 text-sm text-slate-500">Seçili filtreye uygun bilet yok veya henüz yeni bir bilet oluşturulmadı.</p>
      <div class="mt-6">
        <%= link_to "+ Yeni Bilet Oluştur", new_ticket_path, class: "inline-flex items-center rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition" %>
      </div>
    </div>
  <% end %>
</div>
