<!DOCTYPE html>
<html lang="tr" class="h-full bg-slate-50">
  <head>
    <title><%= content_for(:title) || "PulseDesk — Bilet Yönetim Sistemi" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="PulseDesk">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-full font-sans text-slate-900 antialiased">
    <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6 lg:px-8">
        <div class="flex items-center gap-3">
          <%= link_to root_path, class: "flex items-center gap-2.5 group" do %>
            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-indigo-600 text-white shadow-sm transition group-hover:bg-indigo-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
              </svg>
            </span>
            <div>
              <span class="text-lg font-bold tracking-tight text-slate-900">PulseDesk</span>
              <span class="ml-2 hidden rounded-md bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700 sm:inline-block">SLA & Destek Merkezi</span>
            </div>
          <% end %>
        </div>

        <nav class="flex items-center gap-3">
          <%= link_to "Tüm Biletler", tickets_path, class: "rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900 transition" %>
          <%= link_to new_ticket_path, class: "inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition" do %>
            <span>+ Yeni Bilet</span>
          <% end %>
        </nav>
      </div>
    </header>

    <div class="mx-auto max-w-7xl px-4 pt-6 sm:px-6 lg:px-8">
      <% if notice.present? %>
        <div role="alert" class="mb-6 flex items-center justify-between rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3.5 text-sm font-medium text-emerald-900 shadow-xs">
          <div class="flex items-center gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            <span><%= notice %></span>
          </div>
        </div>
      <% end %>

      <% if alert.present? %>
        <div role="alert" class="mb-6 flex items-center justify-between rounded-xl border border-rose-200 bg-rose-50 px-4 py-3.5 text-sm font-medium text-rose-900 shadow-xs">
          <div class="flex items-center gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-rose-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
            </svg>
            <span><%= alert %></span>
          </div>
        </div>
      <% end %>
    </div>

    <main class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
      <%= yield %>
    </main>
  </body>
</html>
